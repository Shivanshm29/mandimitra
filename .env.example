# MANDIMITRA — Environment Configuration Example
# Copy this file to .env and provide your actual secrets.
# NEVER commit .env to version control.

# Required: Sarvam AI API subscription key
SARVAM_API_KEY=your_sarvam_api_key_here

# Required: Secret key for JWT signing (generate a secure random string)
SECRET_KEY=change_this_to_a_secure_random_secret_key_minimum_32_characters

# Database connection URL
# For local SQLite development (default):
DATABASE_URL=sqlite:///./mandimitra.db
# For PostgreSQL (Docker or local service):
# DATABASE_URL=postgresql://mandimitra_user:mandimitra_pass@localhost:5432/mandimitra

# Optional: Data.gov.in Mandi API key
DATA_GOV_IN_API_KEY=

# Application Settings
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

